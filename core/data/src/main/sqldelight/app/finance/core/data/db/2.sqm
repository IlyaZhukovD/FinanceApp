-- Миграция 2 -> 3: срок вклада в месяцах (SPEC.md F4.6, docs/DECISIONS.md D-21).
--
-- Колонка nullable: у существующих счетов срок не задан, и вклад считается бессрочным —
-- процент начисляется, пока счёт открыт. Значение по умолчанию не нужно.
-- Колонка дописывается В КОНЕЦ таблицы, как её объявляет Asset.sq: запросы используют
-- SELECT *, поэтому порядок колонок в свежей и мигрированной базе обязан совпадать.
ALTER TABLE asset_account ADD COLUMN term_months INTEGER;
