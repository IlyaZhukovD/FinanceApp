-- Миграция 8 -> 9: напоминание обновить остаток счёта в конце месяца (DECISIONS D-34).
--
-- Колонка дописывается в конец таблицы — так же она объявлена в Asset.sq. Существующие
-- счета получают 0: напоминаний у них нет, пока пользователь их не включит.
ALTER TABLE asset_account ADD COLUMN monthly_reminder INTEGER NOT NULL DEFAULT 0;
