-- Миграция 4 -> 5: пакеты импорта из Notion (docs/IMPORT-NOTION.md §5.1, DECISIONS D-27).
--
-- Только новые таблицы, существующие не меняются. Определения совпадают с ImportBatch.sq
-- символ в символ по структуре: verifyMigrations сравнивает мигрированную и свежую схему.
CREATE TABLE import_batch (
    id TEXT NOT NULL PRIMARY KEY,
    source TEXT NOT NULL,
    files TEXT NOT NULL,
    rows_total INTEGER NOT NULL,
    rows_imported INTEGER NOT NULL,
    cells_touched INTEGER NOT NULL,
    created_category_ids TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL,
    created_at_utc INTEGER NOT NULL,
    updated_at_utc INTEGER NOT NULL,
    row_version INTEGER NOT NULL DEFAULT 1,
    deleted_at_utc INTEGER
);

CREATE TABLE import_row (
    id TEXT NOT NULL PRIMARY KEY,
    row_key TEXT NOT NULL,
    batch_id TEXT NOT NULL REFERENCES import_batch(id),
    revision_id TEXT NOT NULL REFERENCES category_month_revision(id),
    created_at_utc INTEGER NOT NULL
);

CREATE INDEX idx_import_row_key ON import_row(row_key);

CREATE INDEX idx_import_row_batch ON import_row(batch_id);
