CREATE TABLE category_month_revision (
    id TEXT NOT NULL PRIMARY KEY,
    cell_id TEXT NOT NULL REFERENCES category_month(id),
    op TEXT NOT NULL,
    delta_minor INTEGER,
    amount_before_minor INTEGER,
    amount_after_minor INTEGER NOT NULL,
    currency TEXT NOT NULL DEFAULT 'RUB',
    comment_before TEXT,
    comment_after TEXT,
    source TEXT NOT NULL,
    source_period INTEGER,
    idempotency_key TEXT,
    created_at_utc INTEGER NOT NULL
);

CREATE INDEX idx_revision_cell ON category_month_revision(cell_id, created_at_utc);

CREATE UNIQUE INDEX uq_revision_idempotency
    ON category_month_revision(idempotency_key) WHERE idempotency_key IS NOT NULL;

insert:
INSERT INTO category_month_revision (
    id, cell_id, op, delta_minor, amount_before_minor, amount_after_minor, currency,
    comment_before, comment_after, source, source_period, idempotency_key, created_at_utc
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByCell:
SELECT *
FROM category_month_revision
WHERE cell_id = ?
ORDER BY created_at_utc, rowid;

selectByIdempotencyKey:
SELECT * FROM category_month_revision WHERE idempotency_key = ? LIMIT 1;

countAll:
SELECT COUNT(*) FROM category_month_revision;
