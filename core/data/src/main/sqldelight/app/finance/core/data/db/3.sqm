-- Миграция 3 -> 4: тип счёта активов удалён (SPEC.md F4.2, docs/DECISIONS.md D-22).
--
-- `AssetKind` перестал влиять на поведение ещё в D-20: правило формирования баланса и
-- право на отрицательный остаток задаёт категория, а тип остался меткой, чьи названия
-- почти дублируют имена стартовых категорий («Вклад» и категория «Вклады»). Здесь тип
-- удаляется целиком, поэтому сначала переносим на категорию единственную нагрузку,
-- которая у него осталась.

-- Кредитный счёт мог иметь минус без флага категории: `RecordSnapshot` допускал
-- отрицательный остаток, если его разрешала категория ИЛИ тип (CREDIT). Чтобы такие
-- счета не потеряли право на минус после удаления колонки, проставляем признак их
-- категориям. Учитываем и закрытые/удалённые счета — история их остатков остаётся
-- в базе и должна продолжать читаться.
UPDATE category
SET allows_negative_balance = 1
WHERE section = 'ASSET'
  AND allows_negative_balance = 0
  AND id IN (SELECT category_id FROM asset_account WHERE kind = 'CREDIT');

-- DROP COLUMN поддержан bundled SQLite (org.xerial:sqlite-jdbc 3.51), пересоздание
-- таблицы не нужно: колонка не входит в ключ, индекс, CHECK и не является генерируемой.
-- Порядок остальных колонок сохраняется и совпадает с CREATE TABLE в Asset.sq — это
-- важно, потому что запросы используют SELECT *, а маппер разбирает строку по порядку
-- колонок из .sq файла.
ALTER TABLE asset_account DROP COLUMN kind;
