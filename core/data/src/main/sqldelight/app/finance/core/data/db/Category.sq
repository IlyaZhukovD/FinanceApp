CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    section TEXT NOT NULL,
    name TEXT NOT NULL,
    parent_id TEXT,
    color TEXT NOT NULL,
    icon TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    is_archived INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    created_at_utc INTEGER NOT NULL,
    updated_at_utc INTEGER NOT NULL,
    row_version INTEGER NOT NULL DEFAULT 1,
    deleted_at_utc INTEGER
);

CREATE INDEX idx_category_section ON category(section, is_archived);

selectById:
SELECT * FROM category WHERE id = ?;

selectActiveBySection:
SELECT *
FROM category
WHERE section = ? AND is_archived = 0 AND deleted_at_utc IS NULL
ORDER BY sort_order, name;

selectAllBySection:
SELECT *
FROM category
WHERE section = ? AND deleted_at_utc IS NULL
ORDER BY sort_order, name;

countAll:
SELECT COUNT(*) FROM category;

insert:
INSERT INTO category (
    id, section, name, parent_id, color, icon, sort_order, is_archived,
    created_at_utc, updated_at_utc, row_version, deleted_at_utc
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE category
SET name = ?, color = ?, icon = ?, sort_order = ?, updated_at_utc = ?, row_version = row_version + 1
WHERE id = ?;

archive:
UPDATE category
SET is_archived = 1, updated_at_utc = ?, row_version = row_version + 1
WHERE id = ?;

unarchive:
UPDATE category
SET is_archived = 0, updated_at_utc = ?, row_version = row_version + 1
WHERE id = ?;
