-- Миграция 6 -> 7: день начисления процентов по вкладу (SPEC.md F4.6, DECISIONS D-31).
--
-- Колонка дописывается в конец таблицы — так же она объявлена в Asset.sq: запросы
-- используют SELECT *, и порядок колонок в свежей и мигрированной базе обязан совпадать.
ALTER TABLE asset_account ADD COLUMN interest_day INTEGER;
